# Large vendor payloads / Wine prefix / installer
vendor/
.wine-extract/
.wine-ss3/
captures/*.bin
*.zip
captures/*.reasnap
*.exe
Flydigi Space Station_setup_*.exe

# Archived firmware dumps (full images; intentionally tracked)
!archive/
!archive/**/
!archive/**/*.bin
!archive/**/*.zip
!archive/**/*.json
!archive/**/SHA256SUMS

# Keep docs and small capture text / descriptors
!captures/*.txt
!captures/report-descriptors/
!captures/report-descriptors/**

# Node / Python
node_modules/
__pycache__/
*.pyc
.venv/
dist/
build/
*.egg-info/
packaging/**/*.deb
packaging/**/*.rpm
packaging/**/*.AppImage
*.pkg.tar*
.ruff_cache/

# IDE / agent
.idea/
.vscode/
.claude/
