# Large vendor payloads / Wine prefix / installer
vendor/
.wine-extract/
.wine-ss3/
captures/*.bin
captures/*.pcap
captures/*.pcapng
*.zip
captures/*.reasnap
*.exe
Flydigi Space Station_setup_*.exe

# Archived firmware dumps (full images; intentionally tracked)
!archive/
!archive/**/
!archive/**/*.bin
!archive/**/*.zip
!archive/**/*.json
!archive/**/SHA256SUMS

# Keep docs and small capture text / descriptors / summaries
!captures/*.txt
!captures/*.SUMMARY.md
!captures/report-descriptors/
!captures/report-descriptors/**

# Node / Python
node_modules/
__pycache__/
*.pyc
.venv/
dist/
build/
*.egg-info/
packaging/**/*.deb
packaging/**/*.rpm
packaging/**/*.AppImage
*.pkg.tar*
.ruff_cache/

# IDE / agent
.idea/
.vscode/
.claude/

# Windows VM agent key (local)
tools/win10_agent_ed25519
tools/win10_agent_ed25519.pub
